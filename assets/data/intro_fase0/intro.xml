			</motion>
		</object>
		<object type="text">
			<data align="center" valign="top" text="Aprendiendo a ser Superhéroe" separate-line="5" text-align="center" font-size="22" font-ttf="$fuente$" background-transparent="true" fgR="238" fgG="194" fgB="16" bgR="0" bgG="0" bgB="0" />

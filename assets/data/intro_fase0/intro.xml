<?xml version="1.0" encoding="UTF-8"?>
<anim>
	<control>
		<text-stop align="right" valign="bottom" text="Pulse una tecla para continuar" separate-line="10" text-align="right" x="630" y="475" font-size="17" font-ttf="$fuente$" background-transparent="true" fgR="238" fgG="194" fgB="16" bgR="0" bgG="0" bgB="0" />
		<stop cycle="250" />
		<end cycle="290" />
	</control>
	<objects>
		<object type="sound">
			<data volumen="100" file="opciones.tsog" />
			<sounds>
				<sound cycle-in="10" loops="-1" cycle-out="250" time-fadeout="2000" />
